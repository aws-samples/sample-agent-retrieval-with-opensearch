# Copy to .env at the repository root and fill in. Never commit the real file.

# The collection's host name (used for TLS SNI, the Host header and SigV4 signing). The deploy script prints it, and
# the collection stack outputs it.
OS_HOST=abcdefghij1234567890.us-east-1.aoss.amazonaws.com
# Where requests are actually sent. The collection is private, so this is usually a local port forwarded to the VPC
# endpoint (see docs/setup.md); use https://$OS_HOST if you can reach the endpoint directly.
OS_LOCAL_URL=https://localhost:9301
OS_REGION=us-east-1
# Requests are signed with your AWS credentials (SigV4) for the OpenSearch Serverless service.
OS_AUTH=sigv4
OS_SERVICE=aoss

# Prefix of every object the deploy scripts create, so deployments can coexist in one account.
NAME_PREFIX=sample-agent-ret
# The Region that serves Titan Multimodal Embeddings for the picture vectors (us-east-1 or us-west-2).
# MULTIMODAL_REGION=us-east-1
# Where the memory space is created: one of us-east-1, us-west-2, ap-northeast-1, eu-central-1. Default: OS_REGION if it is
# one of those, else us-east-1.
# MEMORY_REGION=us-east-1
# The Region that serves Cohere Rerank, and optional extra Regions for load.
RERANK_REGION=us-east-1
RERANK_MODEL_ARN=arn:aws:bedrock:us-east-1::foundation-model/cohere.rerank-v3-5:0
# RERANK_EXTRA_REGIONS=us-east-1

# Set by the deploy scripts (infra/serverless/deploy_objects.py): the IAM role OpenSearch assumes to call Bedrock.
# BEDROCK_CONNECTOR_ROLE_ARN=arn:aws:iam::<account>:role/<prefix>-sls-bedrock-connector

# Optional: let the agent also call an external inventory MCP server (docs/setup.md).
# INVENTORY_MCP_ENABLED=1
